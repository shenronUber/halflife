+void R_VFTextureStats( unsigned int *count, unsigned int *bytes )
+{
+	*count = *bytes = 0;
+	for( int i = 0; i < gl_numTextures; i++ )
+	{
+		if( !gl_textures[i].texnum ) continue;
+		(*count)++;
+		*bytes += gl_textures[i].size;
+	}
+}
